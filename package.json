{
  "name": "todotriage",
  "version": "0.1.0",
  "description": "Local-first CLI that turns TODO/FIXME/HACK comments into a ranked maintenance queue.",
  "type": "module",
  "bin": {
    "todotriage": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "check": "tsc -p tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "todo",
    "technical-debt",
    "cli",
    "maintenance",
    "local-first",
    "release-gate"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/todotriage.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/todotriage/issues"
  },
  "homepage": "https://github.com/rogerchappel/todotriage#readme"
}
